# Quest App - Environment Configuration
# Copy this file to .env and fill in your values

# ========================================
# SUPABASE (Required)
# ========================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ========================================
# OPENAI (Required for AI Coach)
# ========================================
# Get API key from: https://platform.openai.com/api-keys
# Model used: gpt-4o-mini
EXPO_PUBLIC_OPENAI_API_KEY=sk-proj-your_openai_key_here

# ========================================
# GOOGLE CALENDAR (Optional)
# ========================================
# Get credentials from: https://console.cloud.google.com
# 1. Create a project
# 2. Enable "Google Calendar API"
# 3. Create OAuth 2.0 credentials (Web application)
# 4. Add authorized redirect URI: your-app://oauth
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_SECRET=your_google_client_secret

# ========================================
# EXPO (Auto-generated, usually not needed)
# ========================================
# EXPO_PUBLIC_APP_VARIANT=development
