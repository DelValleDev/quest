# Quest App - Environment Configuration
# Copy this file to .env and fill in your values

# ========================================
# SUPABASE (Required)
# ========================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ========================================
# OPENAI (Required for AI Coach)
# ========================================
# Get API key from: https://platform.openai.com/api-keys
# Model used: gpt-4o-mini
EXPO_PUBLIC_OPENAI_API_KEY=sk-proj-your_openai_key_here

# ========================================
# GOOGLE CALENDAR (Optional)
# ========================================
# Get credentials from: https://console.cloud.google.com
# 1. Create a project
# 2. Enable "Google Calendar API"
# 3. Create OAuth 2.0 credentials (Web application)
# 4. Add authorized redirect URI: your-app://oauth
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_SECRET=your_google_client_secret

# ========================================
# GOOGLE FIT (Android Health Data)
# ========================================
# Same project as Google Calendar
# Create OAuth 2.0 credentials (Android)
# Use SHA-1 from: eas credentials -p android
EXPO_PUBLIC_GOOGLE_FIT_CLIENT_ID=your_android_client_id.apps.googleusercontent.com

# ========================================
# STRAVA (OAuth Integration for Workouts)
# ========================================
# Get credentials from: https://www.strava.com/settings/api
# 1. Create an app at Strava Settings > API
# 2. Set "Authorization Callback Domain" to: quest://strava-callback
# 3. Copy Client ID and Client Secret
EXPO_PUBLIC_STRAVA_CLIENT_ID=your_strava_client_id_here
EXPO_PUBLIC_STRAVA_CLIENT_SECRET=your_strava_client_secret_here

# ========================================
# SPOTIFY (OAuth Integration for Music Tracking)
# ========================================
# Get credentials from: https://developer.spotify.com/dashboard
# 1. Create an app at Spotify Developer Dashboard
# 2. Add Redirect URI: quest://spotify-callback
# 3. Copy Client ID and Client Secret
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
EXPO_PUBLIC_SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ========================================
# GITHUB (OAuth Integration for Dev Activity)
# ========================================
# Get credentials from: https://github.com/settings/developers
# 1. Create OAuth App at GitHub Developer Settings
# 2. Set "Authorization callback URL" to: quest://github-callback
# 3. Copy Client ID and generate Client Secret
EXPO_PUBLIC_GITHUB_CLIENT_ID=your_github_client_id_here
EXPO_PUBLIC_GITHUB_CLIENT_SECRET=your_github_client_secret_here

# ========================================
# EXPO (Auto-generated, usually not needed)
# ========================================
# EXPO_PUBLIC_APP_VARIANT=development
